# Copy to .env and fill in. .env is git-ignored and docker-ignored: never commit real values.

# ---- naming: "<RollNumber>_A2_Ops" everywhere ----
PROJECT_NAME=ROLLNO_A2_Ops

# ---- MLflow on DagsHub (Task 3.2). Read by MLflow itself from the environment. ----
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-user>/ROLLNO_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

# ---- database (Task 5 / 6.3). Use letters and digits only in the password (it goes into a URL). ----
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=visionguard

# ---- web app (Task 4.4) ----
SECRET_KEY=change-me-run-python-c-import-secrets-print-secrets-token-hex-32
MAX_UPLOAD_MB=5
# Empty = use the threshold chosen on validation data and saved with the model.
THRESHOLD=
WEB_PORT=5000
# Local run only (compose sets its own): MODEL_PATH=models/champion.keras

# ---- Task 8: let the local Flask app call the cloud model API ----
# local = run TensorFlow in the web container; remote = call API_URL
INFERENCE_MODE=local
API_URL=https://<hf-user>-rollno-a2-ops.hf.space
API_KEY=change-me-same-value-as-the-space-secret
